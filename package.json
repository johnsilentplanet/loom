  "description": "A standalone, Claude-powered coding-agent DAG runner (worktree isolation + verify + merge train), subscription-auth only.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "bin": {
    "loom": "./src/cli/main.ts"
